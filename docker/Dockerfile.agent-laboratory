# syntax=docker/dockerfile:1.7
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    RAC_HOST_ROOT=/opt/host \
    HF_HOME=/opt/huggingface-cache \
    SENTENCE_TRANSFORMERS_HOME=/opt/huggingface-cache \
    TIKTOKEN_CACHE_DIR=/opt/tiktoken-cache \
    USE_TF=0

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential git texlive-latex-base texlive-latex-extra texlive-fonts-recommended \
    && rm -rf /var/lib/apt/lists/*

COPY --from=host . /opt/host
COPY pyproject.toml README.md LICENSE /opt/integration/
COPY src /opt/integration/src
COPY configs /opt/integration/configs
COPY upstream.lock.json /opt/integration/upstream.lock.json

RUN python -m pip install --no-cache-dir -r /opt/host/requirements.txt \
    && python -m pip install --no-cache-dir \
        "pypdf>=5,<7" \
        "Flask>=3,<4" \
        "Flask-SQLAlchemy>=3,<4" \
        "tensorflow-cpu==2.18.0" \
    && python -m pip install --no-cache-dir --no-deps \
        "sentence-transformers==3.3.1" \
    && python -m pip install --no-cache-dir -e /opt/integration

RUN mkdir -p /opt/huggingface-cache /opt/tiktoken-cache \
    && python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')" \
    && python -c "import tiktoken; print(tiktoken.get_encoding('cl100k_base').name)"

ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

WORKDIR /opt/integration
ENTRYPOINT ["rac-ai-scientist"]
CMD ["doctor-host", "--host", "agent_laboratory"]
