{
  "schema_version": 1,
  "host_id": "ark",
  "native_entrypoint": "ark run",
  "capabilities": [
    {"capability_id": "researcher", "description": "Frame the research objective and protocol", "tags": ["planning", "literature"], "readable_artifacts": ["task.json", "data/**", "related_work/**"], "writable_artifacts": ["state/**"], "produces": ["plan"], "native_successors": ["experimenter"]},
    {"capability_id": "experimenter", "description": "Run experiments and persist measurements", "tags": ["experiment", "analysis"], "readable_artifacts": ["data/**", "state/**", "code/**"], "writable_artifacts": ["code/**", "outputs/**", "state/**", "report/images/**"], "produces": ["result"], "native_successors": ["writer"]},
    {"capability_id": "coder", "description": "Implement and debug analysis or figures", "tags": ["code", "debug", "figure"], "readable_artifacts": ["data/**", "state/**", "code/**"], "writable_artifacts": ["code/**", "outputs/**", "report/images/**"], "produces": ["code", "figure", "result"], "native_successors": ["writer", "reviewer"]},
    {"capability_id": "writer", "description": "Write the evidence-grounded report", "tags": ["writing", "literature", "finalize"], "readable_artifacts": ["state/**", "outputs/**", "related_work/**"], "writable_artifacts": ["state/**", "report/**"], "produces": ["terminal_report"], "native_successors": ["reviewer"]},
    {"capability_id": "reviewer", "description": "Review terminal artifacts and expose structured issues", "tags": ["terminal_review"], "readable_artifacts": ["report/**", "outputs/**", "code/**"], "writable_artifacts": ["report/**", "state/**"], "produces": ["review"], "native_successors": ["planner", "writer"]},
    {"capability_id": "planner", "description": "Decompose unresolved review issues", "tags": ["planning"], "readable_artifacts": ["state/**"], "writable_artifacts": ["state/**"], "produces": ["plan"], "native_successors": ["experimenter", "coder", "writer"]}
  ]
}
