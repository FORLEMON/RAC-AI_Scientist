# Evaluated model. Never commit populated values.
AGENT_API_BASE=
AGENT_API_KEY=
AGENT_MODEL_NAME=

# Active-host R1-R3 runtime communication. These can instead live in each
# run's <task-dir>/.env (recommended). Create a fresh Room for every episode.
# The room id is non-secret; keep the invite token private.
SHAREDNET_BASE_URL=https://www.sharednet.ai
SHAREDNET_ROOM_ID=
SHAREDNET_INVITE=

# External ResearchClawBench judge. Keep separate from the evaluated model.
JUDGE_PROVIDER=azure
JUDGE_API_BASE=
JUDGE_API_KEY=
JUDGE_MODEL_NAME=
JUDGE_API_VERSION=2025-04-01-preview
JUDGE_MAX_COMPLETION_TOKENS=1000
JUDGE_MAX_WORKERS=1
